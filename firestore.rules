rules_version = '2';

// Firestore Security Rules for Bogus Basin Mountain Hosts
// Deploy these in the Firebase Console: Firestore Database > Rules
//
// These rules allow:
//   - Anyone (public) can READ all data
//   - Authenticated users (Google sign-in) can CREATE comments
//   - Anyone can UPDATE comments (for emoji reactions)
//   - Only authenticated admins can DELETE comments and approve/reject
//   - Only authenticated admins can CREATE/UPDATE/DELETE leaders and announcements

service cloud.firestore {
  match /databases/{database}/documents {

    // COMMENTS: public read, authenticated create/update (reactions require sign-in), admin delete
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;  // reactions now require sign-in
      allow delete: if request.auth != null;
    }

    // LEADERS: public read, admin write
    match /leaders/{leaderId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ANNOUNCEMENTS: public read, admin write
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // SETTINGS (group photo, etc.): public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      // Admin emails doc: only writable by existing admins (or any auth user if no admins exist yet for bootstrapping)
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // =====================================================
    // INTERNAL PORTAL (internal-MH.html) — separate collections
    // Authenticated access only — user must sign in to read or write
    // =====================================================

    // INTERNAL COMMENTS: authenticated read/create/update, admin delete
    match /internal_comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // INTERNAL LEADERS: authenticated read, admin write
    match /internal_leaders/{leaderId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // INTERNAL DIRECTORS (Board of Directors): authenticated read, admin write
    match /internal_directors/{directorId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // INTERNAL ANNOUNCEMENTS: authenticated read, admin write
    match /internal_announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // INTERNAL MEETING MINUTES: authenticated read, admin write
    match /internal_minutes/{minuteId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // INTERNAL SETTINGS: public read for auth gate verification, admin write
    match /internal_settings/{settingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // INTERNAL T&C AGREEMENTS: users can read/create their own, admins can read all
    match /internal_tc_agreements/{odid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
